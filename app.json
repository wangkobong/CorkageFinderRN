{
  "expo": {
    "name": "corkagefinder",
    "slug": "corkageFinder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/react-logo.png",
    "scheme": "corkagefinder",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": ["https://devrepo.kakao.com/nexus/content/groups/public/"]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ee905714-a270-40e9-a723-ec275c286a31"
      }
    },
    "android": {
      "package": "com.sungyeon.corkagefinder"
    },
    "ios": {
      "bundleIdentifier": "com.sungyeon.corkagefinder",
      "appleTeamId": "YWSA3TX7T7"
    }
  }
}
